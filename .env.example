# ClawMind configuration. Copy to .env (run.py does this for you) and fill in.
# Never commit .env.

# --- AI model (any OpenAI-compatible API) ---
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  LLM_API_KEY=ollama
# Leave empty to run in offline mode (simple commands only).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=90

# Optional: embedding model for semantic memory search, served by the same provider.
# OpenAI: text-embedding-3-small   Ollama: nomic-embed-text
# Leave empty to use keyword search.
EMBEDDING_MODEL=

# --- Server ---
# Keep 127.0.0.1 unless you know what you're doing. Any other value requires AUTH_ENABLED=true.
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Extra host names allowed in the Host header (comma separated), e.g. clawmind.mylan.example
ALLOWED_HOSTS=
# Other origins allowed to call the API from a browser (comma separated). Usually empty.
CORS_ORIGINS=

# --- Authentication (needed when HOST is not 127.0.0.1) ---
# Run "python run.py --set-password" to fill these in.
AUTH_ENABLED=false
AUTH_PASSWORD_HASH=
# Set to true when ClawMind is served over HTTPS
COOKIE_SECURE=false

# --- Folders (relative to the project folder) ---
DATA_DIR=data
WORKSPACE_DIR=workspace

# --- Agent limits ---
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20

# --- Web ---
# duckduckgo (no key needed), brave (needs BRAVE_API_KEY) or searxng (needs SEARXNG_URL)
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=
SEARXNG_URL=
FETCH_TIMEOUT=15
FETCH_MAX_BYTES=2000000

# --- Tools ---
ENABLE_PYTHON_TOOL=true
PYTHON_TIMEOUT=20
# The browser tool is off by default. When enabled, run.py installs Chromium on first start.
ENABLE_BROWSER=false
# Optional path to an existing Chrome/Chromium binary instead of Playwright's download
BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT=20

# --- API protection ---
MAX_REQUEST_BYTES=64000
# Chat requests per minute per client
CHAT_RATE_LIMIT=30
